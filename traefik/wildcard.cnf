# OpenSSL config used by `make wildcard-cert` (see Makefile). Drives the
# CSR/x509 generation for the Traefik wildcard cert. The wildcard covers
# both the apex (<host>.local) and any one-label subdomain (*.<host>.local) —
# that's all the Traefik routes ever match. The name comes from CERT_HOST,
# which the Makefile exports (default: this host's short hostname + .local,
# the same name `mdns/` publishes aliases under).

[req]
distinguished_name = req_distinguished_name
req_extensions     = v3_req
prompt             = no

[req_distinguished_name]
CN = $ENV::CERT_HOST
O  = sparky

[v3_req]
basicConstraints      = critical, CA:FALSE
keyUsage              = critical, digitalSignature, keyEncipherment
extendedKeyUsage      = serverAuth
subjectAltName        = @alt_names

[alt_names]
DNS.1 = $ENV::CERT_HOST
DNS.2 = *.$ENV::CERT_HOST

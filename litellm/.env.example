# litellm stack config. Copy to .env and fill the secrets (compose refuses to
# start without them). Generate each with:  openssl rand -hex 24

# LiteLLM image. `main-stable` floats; pin a release in your host-local .env for
# production (tags: https://github.com/BerriAI/litellm/pkgs/container/litellm).
LITELLM_TAG=main-stable

# Postgres holds virtual keys, teams and spend. Pin a major version: a major
# upgrade needs a dump/restore, so it must never move by itself.
POSTGRES_TAG=17-alpine

# Admin key and the first key to call the API with: `Authorization: Bearer <key>`.
# Must start with sk-.   e.g.  sk-$(openssl rand -hex 24)
LITELLM_MASTER_KEY=

# Encrypts credentials LiteLLM stores in Postgres. Set once and keep: changing it
# makes what is already stored unreadable.
LITELLM_SALT_KEY=

POSTGRES_PASSWORD=

# Only if you set TENSORFOLD_API_KEY in models/qwen38/.env: the same value.
# QWEN38_API_KEY=

# Loopback port on the host for direct curl.
# HOST_PORT=4000

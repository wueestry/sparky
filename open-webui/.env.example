# Image tag. Defaults below track `latest` for convenience.
# In production, pin to a specific release in your local .env:
#   OPEN_WEBUI_TAG=v0.9.5
# Releases: https://github.com/open-webui/open-webui/releases
OPEN_WEBUI_TAG=latest

# Open WebUI session secret. Generate with: openssl rand -hex 32
# REQUIRED — compose refuses to start if unset.
WEBUI_SECRET_KEY=

# A LiteLLM key for Open WebUI to call the gateway with (litellm/). Create a
# dedicated virtual key rather than reusing the master key — see README.
# REQUIRED — compose refuses to start if unset.
LITELLM_API_KEY=

# Require login (true) or run open (false). Keep true.
WEBUI_AUTH=true

# Allow new user signups. Leave true for initial admin registration,
# then set to false and `docker compose up -d` to lock down.
ENABLE_SIGNUP=true

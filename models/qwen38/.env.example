# Host-wide config for the qwen38 stack. Copy to .env (`make up` does it on
# the first run).
#
# Two readers use this file:
#   - upstream/scripts/config.sh, so EVERY knob of the MiaAI-Lab recipe works
#     here unchanged: CONTEXT, PARALLEL, VISION, KV_DTYPE, THINKING, DRAFTS,
#     TEMPERATURE, TOP_P, TOP_K, MAX_TOKENS, MODEL_ID, TENSORFOLD_*, TF_FLASHNEXT_*
#     ... Read the comments in upstream/scripts/config.sh for each one.
#   - docker-compose.yml, via `make env`, for the few settings below.
# KEY=value lines only; values are read, never executed.

# Where model files live. The default is the host's shared Hugging Face cache, so
# anything already downloaded there is reused: the checkpoint goes to
# $HF_CACHE/hub (~96 GiB). The user running
# `make` needs write access here (rootless Docker maps container root to it).
HF_CACHE=/opt/hf/.cache/huggingface

# TensorFold's compiled-kernel cache and upstream's lock/marker files.
KERNEL_CACHE=/opt/hf/.cache/tensorfold-qwen38
STATE_DIR=/opt/hf/.cache/tensorfold-qwen38/state
LOG_DIR=/opt/hf/.cache/tensorfold-qwen38/logs

# Optional HuggingFace token (only needed for gated repos).
HF_TOKEN=

# Optional bearer key the engine itself requires. Leave empty when LiteLLM is
# the only client (it is on the same private network); if you set it, set the
# same value as TENSORFOLD_API_KEY in litellm/.env.
# TENSORFOLD_API_KEY=

# Loopback port on the host for direct curl (default: the engine's port, 8888).
# HOST_PORT=8888

# Set to 0 to start even when less memory is available than the recipe wants.
# On the GB10 running out of unified memory can hang the host: leave it on.
# MEM_CHECK=1

# Examples of recipe knobs (defaults shown by upstream/scripts/config.sh):
# CONTEXT=262144
# PARALLEL=5
# VISION=1

# Settings for the host firewall. Copy to .env (KEY=value lines; read, never executed).

# The local network that may reach this host and that this host may reach.
LAN_CIDR=192.168.1.0/24

# User the NTP client runs as (name or numeric UID). Allowed to send udp/123 anywhere
# so the clock stays right (Tailscale's TLS needs it). `ps -o user= -C systemd-timesyn`
TIMESYNC_USER=systemd-timesync

# audit   : log what WOULD be blocked (with the owning UID) and allow it. Run this first.
# enforce : block it.
MODE=audit

# `make apply` reverts to the previous ruleset after this many seconds unless you
# run `make confirm` (from a second SSH session, after checking you can still get in).
REVERT_SECONDS=120

# Settings for the host firewall. Copy to .env (KEY=value lines; read, never executed).

# The local network that may reach this host and that this host may reach.
LAN_CIDR=192.168.1.0/24

# Internet NTP servers the host may reach on udp/123 (comma-separated IPv4 addresses;
# nftables cannot match hostnames). Leave empty to allow NTP to the LAN only (the router
# or a LAN time server: point timesyncd/chrony at it). The clock matters: Tailscale's TLS needs it.
NTP_SERVERS=

# enforce : block it (default). `make apply` refuses it until an audit has been reviewed.
# audit   : log what WOULD be blocked (with the owning UID) and allow it. Run this first:
#           `make apply MODE=audit`, then `make audit-report` a few days later.
MODE=enforce

# `make apply` reverts to the previous ruleset after this many seconds unless you
# run `make confirm` (from a second SSH session, after checking you can still get in).
REVERT_SECONDS=120
